{
  "manifest_version": 3,
  "name": "RunSafe",
  "version": "0.2.0",
  "description": "Shows recent reported crime from police open data as a heatmap on Google Maps, and rates running routes. 16 areas so far.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://cos-data.seattle.gov/*",
    "https://data.cityofchicago.org/*",
    "https://data.cityofnewyork.us/*",
    "https://gis.charlottenc.gov/*",
    "https://mapit.fortworthtexas.gov/*",
    "https://maps.cityofrochester.gov/*",
    "https://routing.openstreetmap.de/*",
    "https://services.arcgis.com/*",
    "https://services1.arcgis.com/*",
    "https://services2.arcgis.com/*",
    "https://services3.arcgis.com/*",
    "https://services6.arcgis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*"
      ],
      "js": [
        "lib/score.js",
        "lib/format.js",
        "lib/cities.js",
        "lib/sources.js",
        "lib/live.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "RunSafe: show or hide on Google Maps, or open the full heatmap"
  }
}
